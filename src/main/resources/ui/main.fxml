<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #2F4F4F;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MainController">

    <!-- TOP: Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1C3333;                    -fx-border-color: #4A7C7C;                    -fx-border-width: 0 0 2 0;                    -fx-padding: 12 20 12 20;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="⚙  CPU Scheduling Simulator" textFill="WHITE" />
            <Label style="-fx-font-size: 13px;" text="  Round Robin  vs  Priority Scheduling" textFill="#A8C4C4" />
        </HBox>
    </top>

    <!-- LEFT: Input + Scenarios + Result Panel -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #1C3333;                    -fx-background-color: #1C3333;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox prefWidth="210" spacing="10" style="-fx-padding: 12;                            -fx-background-color: #1C3333;                            -fx-border-color: #4A7C7C;                            -fx-border-width: 0 2 0 0;">

                    <!-- INPUT SECTION -->
                    <Label text="INPUT SECTION" textFill="#A8C4C4">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>

                    <TextField fx:id="tfPid" promptText="Process ID  e.g. 1" style="-fx-background-color: #2F4F4F;                                -fx-text-fill: white;                                -fx-prompt-text-fill: #708090;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-padding: 6;" />

                    <TextField fx:id="tfArrival" promptText="Arrival Time" style="-fx-background-color: #2F4F4F;                                -fx-text-fill: white;                                -fx-prompt-text-fill: #708090;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-padding: 6;" />

                    <TextField fx:id="tfBurst" promptText="Burst Time" style="-fx-background-color: #2F4F4F;                                -fx-text-fill: white;                                -fx-prompt-text-fill: #708090;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-padding: 6;" />

                    <TextField fx:id="tfPriority" promptText="Priority  (1=highest)" style="-fx-background-color: #2F4F4F;                                -fx-text-fill: white;                                -fx-prompt-text-fill: #708090;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-padding: 6;" />

                    <HBox spacing="8">
                        <Button onAction="#handleAddProcess" prefHeight="28" prefWidth="88" style="-fx-background-color: #3A6B6B;                                    -fx-text-fill: white;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 4;                                    -fx-background-radius: 4;                                    -fx-cursor: hand;" text="＋ Add" />
                        <Button onAction="#handleRemoveProcess" prefHeight="28" prefWidth="88" style="-fx-background-color: #6B2737;                                    -fx-text-fill: white;                                    -fx-border-color: #8B3A4A;                                    -fx-border-radius: 4;                                    -fx-background-radius: 4;                                    -fx-cursor: hand;" text="✕ Delete" />
                    </HBox>

                    <Button alignment="CENTER" onAction="#handleClear" prefHeight="28" prefWidth="88" style="-fx-background-color: #556B2F;                                -fx-text-fill: white;                                -fx-border-color: #6B8B3A;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;" text="⟳ Clear">
                        <VBox.margin><Insets left="58" /></VBox.margin>
                    </Button>

                    <Separator style="-fx-background-color: #4A7C7C;" />

                    <TextField fx:id="tfQuantum" promptText="Time Quantum" style="-fx-background-color: #2F4F4F;                                -fx-text-fill: white;                                -fx-prompt-text-fill: #708090;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-padding: 6;" />

                    <Button maxWidth="Infinity" onAction="#handleRun" style="-fx-background-color: #4A7C4A;                                -fx-text-fill: white;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;                                -fx-padding: 8;" text="▶  Run Simulation">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Button>

                    <Separator style="-fx-background-color: #4A7C7C;" />

                    <!-- TEST SCENARIOS SECTION -->
                    <Label text="TEST SCENARIOS" textFill="#A8C4C4">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>

                    <Label style="-fx-font-size: 10px;" text="Click to load a preset scenario and run simulation automatically" textFill="#708090" wrapText="true" />

                    <Button maxWidth="Infinity" onAction="#handleScenarioA" style="-fx-background-color: #2C4A6B;                                -fx-text-fill: white;                                -fx-border-color: #4A7C9C;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;                                -fx-padding: 7;                                -fx-font-size: 11px;" text="Scenario A — Basic Mixed" wrapText="true" />

                    <Button maxWidth="Infinity" onAction="#handleScenarioB" style="-fx-background-color: #4A3A1C;                                -fx-text-fill: white;                                -fx-border-color: #8B6A2A;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;                                -fx-padding: 7;                                -fx-font-size: 11px;" text="Scenario B — Urgency Case" wrapText="true" />

                    <Button maxWidth="Infinity" onAction="#handleScenarioC" style="-fx-background-color: #1C4A2C;                                -fx-text-fill: white;                                -fx-border-color: #2A8B4A;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;                                -fx-padding: 7;                                -fx-font-size: 11px;" text="Scenario C — Fairness Case" wrapText="true" />

                    <Button maxWidth="Infinity" onAction="#handleScenarioD" style="-fx-background-color: #4A1C1C;                                -fx-text-fill: white;                                -fx-border-color: #8B2A2A;                                -fx-border-radius: 4;                                -fx-background-radius: 4;                                -fx-cursor: hand;                                -fx-padding: 7;                                -fx-font-size: 11px;" text="Scenario D — Starvation Case" wrapText="true" />

                    <Separator style="-fx-background-color: #4A7C7C;" />

                    <!-- RESULT: Winner + Scenario ONLY -->
                    <Label text="RESULT" textFill="#A8C4C4">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>

                    <VBox spacing="8" style="-fx-background-color: #243F3F;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 6;                                -fx-background-radius: 6;                                -fx-padding: 10;">

                        <Label style="-fx-font-size: 11px;                                       -fx-font-weight: bold;" text="Winner" textFill="#A8C4C4" />
                        <Label fx:id="bestAlgoLabel" style="-fx-font-size: 13px;                                    -fx-font-weight: bold;" text="—" textFill="WHITE" wrapText="true" />
                    </VBox>

                    <BorderPane.margin>
                        <Insets left="10" right="5" />
                    </BorderPane.margin>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- CENTER: All Results -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #2F4F4F;                    -fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14" style="-fx-padding: 14;">

                    <!-- PROCESS TABLE -->
                    <Label text="PROCESS TABLE" textFill="WHITE">
                        <font><Font name="System Bold" size="13.0" /></font>
                    </Label>

                    <TableView fx:id="processTable" maxWidth="560" prefHeight="150" style="-fx-background-color: white;                                -fx-table-cell-border-color: black;                                -fx-border-color: black;                                -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="colPid" prefWidth="100" text="PID" />
                            <TableColumn fx:id="colArrival" prefWidth="120" text="Arrival" />
                            <TableColumn fx:id="colBurst" prefWidth="120" text="Burst" />
                            <TableColumn fx:id="colPriority" prefWidth="120" text="Priority" />
                        </columns>
                    </TableView>

                    <!-- READY QUEUES -->
                    <VBox spacing="8" style="-fx-background-color: #243F3F;                                -fx-padding: 10;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 6;">

                        <Label text="Ready Queue  —  Round Robin" textFill="#A8C4C4">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label fx:id="rrQueueLabel" style="-fx-background-color: #1C3333;                                    -fx-padding: 8;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 4;                                    -fx-font-size: 12;" text="Queue: [ ]" textFill="WHITE" wrapText="true" />

                        <Label text="Ready Queue  —  Priority Scheduling" textFill="#A8C4C4">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label fx:id="pqQueueLabel" style="-fx-background-color: #1C3333;                                    -fx-padding: 8;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 4;                                    -fx-font-size: 12;" text="Queue: [ ]" textFill="WHITE" wrapText="true" />
                    </VBox>

                    <!-- GANTT + RESULTS SIDE BY SIDE -->
                    <HBox spacing="16">

                        <!-- ROUND ROBIN Column -->
                        <VBox spacing="10" style="-fx-background-color: #243F3F;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 6;                                    -fx-padding: 12;" HBox.hgrow="ALWAYS">

                            <Label text="① ROUND ROBIN" textFill="WHITE">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>

                            <Label style="-fx-font-size: 11px;                                           -fx-font-weight: bold;" text="Gantt Chart" textFill="#FFD700" />

                            <ScrollPane fx:id="rrGanttScroll" fitToHeight="false" hbarPolicy="AS_NEEDED" prefHeight="95" style="-fx-background-color: #1C3333;                                        -fx-background: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-radius: 4;" vbarPolicy="NEVER">
                                <content>
                                    <Pane fx:id="rrGanttPane" prefHeight="75" style="-fx-background-color: #1C3333;">
                                        <padding>
                                            <Insets bottom="6" left="8" right="8" top="6" />
                                        </padding>
                                    </Pane>
                                </content>
                            </ScrollPane>

                            <Label style="-fx-font-size: 11px;                                           -fx-font-weight: bold;" text="Results Table" textFill="#FFD700" />

                            <TableView fx:id="rrResultTable" maxWidth="Infinity" prefHeight="200" style="-fx-background-color: white;                                        -fx-table-cell-border-color: black;                                        -fx-border-color: black;                                        -fx-border-width: 1;">
                                <columns>
                                    <TableColumn fx:id="rrColPid" prefWidth="70" text="PID" />
                                    <TableColumn fx:id="rrColFt" prefWidth="65" text="FT" />
                                    <TableColumn fx:id="rrColTat" prefWidth="65" text="TAT" />
                                    <TableColumn fx:id="rrColWt" prefWidth="65" text="WT" />
                                    <TableColumn fx:id="rrColRt" prefWidth="65" text="RT" />
                                </columns>
                            </TableView>

                            <Label fx:id="rrAvgLabel" style="-fx-font-size: 11;                                        -fx-padding: 6;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-radius: 4;" text="Avg WT: —  |  Avg TAT: —  |  Avg RT: —" textFill="#FFD700" wrapText="true" />
                        </VBox>

                        <!-- PRIORITY Column -->
                        <VBox spacing="10" style="-fx-background-color: #243F3F;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 6;                                    -fx-padding: 12;" HBox.hgrow="ALWAYS">

                            <Label text="② PRIORITY SCHEDULING" textFill="WHITE">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Label>

                            <Label style="-fx-font-size: 11px;                                           -fx-font-weight: bold;" text="Gantt Chart" textFill="#FFD700" />

                            <ScrollPane fx:id="pqGanttScroll" fitToHeight="false" hbarPolicy="AS_NEEDED" prefHeight="95" style="-fx-background-color: #1C3333;                                        -fx-background: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-radius: 4;" vbarPolicy="NEVER">
                                <content>
                                    <Pane fx:id="pqGanttPane" prefHeight="75" style="-fx-background-color: #1C3333;">
                                        <padding>
                                            <Insets bottom="6" left="8" right="8" top="6" />
                                        </padding>
                                    </Pane>
                                </content>
                            </ScrollPane>

                            <Label style="-fx-font-size: 11px;                                           -fx-font-weight: bold;" text="Results Table" textFill="#FFD700" />

                            <TableView fx:id="pqResultTable" maxWidth="Infinity" prefHeight="200" style="-fx-background-color: white;                                        -fx-table-cell-border-color: black;                                        -fx-border-color: black;                                        -fx-border-width: 1;">
                                <columns>
                                    <TableColumn fx:id="pqColPid" prefWidth="70" text="PID" />
                                    <TableColumn fx:id="pqColFt" prefWidth="65" text="FT" />
                                    <TableColumn fx:id="pqColTat" prefWidth="65" text="TAT" />
                                    <TableColumn fx:id="pqColWt" prefWidth="65" text="WT" />
                                    <TableColumn fx:id="pqColRt" prefWidth="65" text="RT" />
                                </columns>
                            </TableView>

                            <Label fx:id="pqAvgLabel" style="-fx-font-size: 11;                                        -fx-padding: 6;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-radius: 4;" text="Avg WT: —  |  Avg TAT: —  |  Avg RT: —" textFill="#FFD700" wrapText="true" />
                        </VBox>
                    </HBox>

                    <!-- COMPARISON SUMMARY -->
                    <VBox spacing="10" style="-fx-background-color: #243F3F;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 6;                                -fx-padding: 12;">

                        <Label text="③ COMPARISON SUMMARY" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>

                        <!-- Header Row -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: black;                                        -fx-font-weight: bold;                                        -fx-background-color: #B0C4C4;                                        -fx-border-color: black;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Metric" />
                            <Label prefWidth="160" style="-fx-text-fill: black;                                        -fx-font-weight: bold;                                        -fx-background-color: #B0C4C4;                                        -fx-border-color: black;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Round Robin" />
                            <Label prefWidth="160" style="-fx-text-fill: black;                                        -fx-font-weight: bold;                                        -fx-background-color: #B0C4C4;                                        -fx-border-color: black;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Priority" />
                        </HBox>

                        <!-- Avg Waiting Time -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Avg Waiting Time" />
                            <Label fx:id="rrAvgWtLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                            <Label fx:id="pqAvgWtLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                        </HBox>

                        <!-- Avg Turnaround Time -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Avg Turnaround Time" />
                            <Label fx:id="rrAvgTatLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                            <Label fx:id="pqAvgTatLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                        </HBox>

                        <!-- Avg Response Time -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Avg Response Time" />
                            <Label fx:id="rrAvgRtLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                            <Label fx:id="pqAvgRtLabel" prefWidth="160" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="—" />
                        </HBox>

                        <!-- Starvation Risk (static) -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Starvation Risk" />
                            <Label prefWidth="160" style="-fx-text-fill: #4CAF50;                                        -fx-font-weight: bold;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="None ✓" />
                            <Label prefWidth="160" style="-fx-text-fill: #FF6B6B;                                        -fx-font-weight: bold;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Possible ⚠" />
                        </HBox>

                        <!-- Fairness (static) -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Fairness" />
                            <Label prefWidth="160" style="-fx-text-fill: #4CAF50;                                        -fx-font-weight: bold;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="High ✓" />
                            <Label prefWidth="160" style="-fx-text-fill: #FF6B6B;                                        -fx-font-weight: bold;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Low ✗" />
                        </HBox>

                        <!-- Best For (static) -->
                        <HBox spacing="2">
                            <Label prefWidth="200" style="-fx-text-fill: white;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Best For" />
                            <Label prefWidth="160" style="-fx-text-fill: #A8C4C4;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Interactive Systems" />
                            <Label prefWidth="160" style="-fx-text-fill: #A8C4C4;                                        -fx-background-color: #1C3333;                                        -fx-border-color: #4A7C7C;                                        -fx-border-width: 1;                                        -fx-padding: 6 10 6 10;" text="Batch / Priority Jobs" />
                        </HBox>
                    </VBox>

                    <!-- FINAL CONCLUSION -->
                    <VBox spacing="10" style="-fx-background-color: #243F3F;                                -fx-border-color: #4A7C7C;                                -fx-border-radius: 6;                                -fx-padding: 12;">

                        <Label text="④ FINAL CONCLUSION" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>

                        <VBox fx:id="conclusionContent" spacing="8" />

                        <Label style="-fx-font-size: 11px;                                       -fx-font-weight: bold;" text="Written Conclusion" textFill="#FFD700" />

                        <TextArea fx:id="conclusionText" editable="false" prefHeight="180" style="-fx-control-inner-background: #1C3333;                                    -fx-text-fill: white;                                    -fx-font-size: 12;                                    -fx-border-color: #4A7C7C;                                    -fx-border-radius: 4;" text="Run the simulation to generate the conclusion." wrapText="true" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
